{
  "name": "le-maia",
  "version": "1.0.0",
  "private": true,
  "description": "Catálogo online premium Le Maia — Vercel + Supabase + Cloudinary",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=le-maia-frontend",
    "dev:frontend": "npm run dev --workspace=le-maia-frontend",
    "dev:clean": "npm run dev:clean --workspace=le-maia-frontend",
    "build": "npm run build --workspace=le-maia-frontend",
    "start": "npm run start --workspace=le-maia-frontend",
    "lint": "npm run lint --workspace=le-maia-frontend",
    "db:migrate": "npm run db:migrate --workspace=le-maia-frontend",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=le-maia-frontend",
    "db:seed": "npm run db:seed --workspace=le-maia-frontend",
    "db:studio": "npm run db:studio --workspace=le-maia-frontend",
    "deploy:check": "node scripts/deploy/check-env.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  }
