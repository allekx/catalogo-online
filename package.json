{
  "name": "le-maia",
  "version": "1.0.0",
  "private": true,
  "description": "Catálogo online premium Le Maia — bolsas personalizadas femininas",
  "workspaces": [
    "frontend",
    "backend",
    "admin"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=le-maia-frontend",
    "dev:clean": "npm run dev:clean --workspace=le-maia-frontend",
    "dev:frontend": "npm run dev --workspace=le-maia-frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:admin": "npm run dev --workspace=admin",
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace=le-maia-frontend",
    "build:backend": "npm run build --workspace=backend",
    "start:frontend": "npm run start --workspace=le-maia-frontend",
    "start:backend": "npm run start --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend",
    "lint": "npm run lint --workspaces --if-present",
    "deploy:check": "node scripts/deploy/check-env.mjs all",
    "deploy:check:frontend": "node scripts/deploy/check-env.mjs frontend",
    "deploy:check:backend": "node scripts/deploy/check-env.mjs backend",
    "deploy:check:admin": "node scripts/deploy/check-env.mjs admin",
    "deploy:pre": "powershell -ExecutionPolicy Bypass -File scripts/deploy/pre-deploy.ps1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
