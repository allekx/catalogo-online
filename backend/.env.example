# =============================================================================
# Le Maia Backend — Railway
# Copie para backend/.env (dev) ou variáveis no painel Railway (produção)
# =============================================================================

PORT=4000
NODE_ENV=development

# Produção (Railway): NODE_ENV=production

# -----------------------------------------------------------------------------
# PostgreSQL (Supabase) — tabelas: categories, products, product_images,
# orders, order_items, customers, favorites, users
# Após configurar: npm run db:push && npm run db:seed
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Supabase PostgreSQL
# Obtenha em: Supabase → Project Settings → Database
# -----------------------------------------------------------------------------
# Transaction pooler (porta 6543) — runtime / API
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Session pooler (porta 5432) — migrations (prisma migrate, db push)
# Codifique caracteres especiais na senha (* → %2A, @ → %40, etc.)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# CORS — origens permitidas (vírgula, sem espaços extras)
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Cloudinary — upload de imagens
# Obtenha em: Cloudinary Dashboard → Account Details
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=le-maia

# Chave para proteger POST /api/upload (header: x-api-key)
UPLOAD_API_KEY=dev-upload-key-change-in-production

# -----------------------------------------------------------------------------
# Painel Admin — /api/admin
# -----------------------------------------------------------------------------
ADMIN_API_KEY=dev-admin-key
ADMIN_PASSWORD=lemaia2024
