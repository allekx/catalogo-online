# =============================================================================
# Le Maia — Vercel (catálogo + API + admin)
# Copie para .env.local (dev) ou configure no painel Vercel (produção)
# =============================================================================

# URL pública do site (SEO, PWA, SSR interno da API)
# Produção Vercel: sempre com https:// (ex.: https://catalogo-online.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: forçar URL da API (padrão = mesmo origin /api)
# NEXT_PUBLIC_API_URL=http://localhost:3000/api

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
SEO_REVALIDATE_SECONDS=300

NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999
NEXT_PUBLIC_WHATSAPP_MESSAGE=Olá! Gostaria de saber mais sobre as bolsas Le Maia.
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/lemaia

# -----------------------------------------------------------------------------
# Supabase PostgreSQL (Prisma)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Cloudinary
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=le-maia

# -----------------------------------------------------------------------------
# Admin + upload (server-only — não expor no cliente)
# -----------------------------------------------------------------------------
ADMIN_API_KEY=
ADMIN_PASSWORD=
UPLOAD_API_KEY=
