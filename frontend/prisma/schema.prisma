// =============================================================================
// Le Maia — Modelagem PostgreSQL (Prisma)
// Tabelas: categories, products, product_images, orders, order_items,
//          customers, favorites (+ users para evolução admin)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// Categorias
// -----------------------------------------------------------------------------

model Category {
  id                 String    @id @default(cuid())
  slug               String
  name               String
  description        String?   @db.Text
  imageUrl           String?   @map("image_url")
  cloudinaryPublicId String?   @map("cloudinary_public_id")
  sortOrder          Int       @default(0) @map("sort_order")
  active             Boolean   @default(true)
  products           Product[]
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  @@unique([slug])
  @@index([slug])
  @@index([sortOrder])
  @@index([active])
  @@index([deletedAt])
  @@map("categories")
}

// -----------------------------------------------------------------------------
// Produtos
// -----------------------------------------------------------------------------

model Product {
  id                 String         @id @default(cuid())
  slug               String
  name               String
  description        String         @db.Text
  price              Decimal        @db.Decimal(10, 2)
  /// URL da imagem principal (cache da ProductImage isPrimary)
  imageUrl           String         @map("image_url")
  cloudinaryPublicId String?        @map("cloudinary_public_id")
  featured           Boolean        @default(false)
  isNew              Boolean        @default(false) @map("is_new")
  productType        String?        @map("product_type")
  active             Boolean        @default(true)
  stock              Int            @default(0)
  salesCount         Int            @default(0) @map("sales_count")
  viewCount          Int            @default(0) @map("view_count")
  whatsappClicks     Int            @default(0) @map("whatsapp_clicks")
  categoryId         String         @map("category_id")
  category           Category       @relation(fields: [categoryId], references: [id])
  images             ProductImage[]
  favorites          Favorite[]
  orderItems         OrderItem[]
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  deletedAt          DateTime?      @map("deleted_at")

  @@unique([slug])
  @@index([slug])
  @@index([categoryId])
  @@index([categoryId, active, deletedAt])
  @@index([featured, active])
  @@index([active])
  @@index([isNew])
  @@index([productType])
  @@index([viewCount])
  @@index([salesCount])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("products")
}

// -----------------------------------------------------------------------------
// Imagens do produto (galeria ordenada)
// -----------------------------------------------------------------------------

model ProductImage {
  id                 String    @id @default(cuid())
  productId          String    @map("product_id")
  product            Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url                String
  cloudinaryPublicId String?   @map("cloudinary_public_id")
  altText            String?   @map("alt_text")
  sortOrder          Int       @default(0) @map("sort_order")
  isPrimary          Boolean   @default(false) @map("is_primary")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  @@index([productId])
  @@index([productId, sortOrder])
  @@index([productId, isPrimary])
  @@index([deletedAt])
  @@map("product_images")
}

// -----------------------------------------------------------------------------
// Clientes
// -----------------------------------------------------------------------------

model Customer {
  id        String     @id @default(cuid())
  name      String
  email     String?
  phone     String?
  city      String?
  state     String?
  notes     String?    @db.Text
  orders    Order[]
  favorites Favorite[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  @@index([email])
  @@index([phone])
  @@index([name])
  @@index([deletedAt])
  @@map("customers")
}

// -----------------------------------------------------------------------------
// Pedidos
// -----------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  WHATSAPP_SENT
  CONFIRMED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique @map("order_number")
  status       OrderStatus @default(WHATSAPP_SENT)
  customerId   String      @map("customer_id")
  customer     Customer    @relation(fields: [customerId], references: [id])
  items        OrderItem[]
  subtotal     Decimal     @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)
  notes        String?     @db.Text
  whatsappSent Boolean     @default(true) @map("whatsapp_sent")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")

  @@index([orderNumber])
  @@index([status])
  @@index([customerId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?  @map("product_id")
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name         String
  quantity     Int      @default(1)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  lineTotal    Decimal  @map("line_total") @db.Decimal(10, 2)
  observations String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// -----------------------------------------------------------------------------
// Favoritos (cliente identificado ou sessão anônima)
// -----------------------------------------------------------------------------

model Favorite {
  id         String    @id @default(cuid())
  productId  String    @map("product_id")
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Identificador de sessão/dispositivo para visitantes sem login
  guestKey   String?   @map("guest_key")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  @@unique([productId, customerId])
  @@unique([productId, guestKey])
  @@index([productId])
  @@index([customerId])
  @@index([guestKey])
  @@index([deletedAt])
  @@index([customerId, deletedAt])
  @@index([guestKey, deletedAt])
  @@map("favorites")
}

// -----------------------------------------------------------------------------
// Usuários (evolução: login admin / conta cliente)
// -----------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  role      Role      @default(CUSTOMER)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}
